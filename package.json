{
  "devDependencies": {
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "backend/src/!(generated)/**/*.ts": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "backend/*.{ts,js}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "**/*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "backend/src/*.ts": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ]
  }
}
