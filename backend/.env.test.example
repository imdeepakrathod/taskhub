NODE_ENV=test
PORT=4001
CLIENT_URL=http://localhost:5173
# Must point to a dedicated test database — tests truncate tables
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taskhub_test?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-32-plus-character-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-32-plus-character-random-string"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d